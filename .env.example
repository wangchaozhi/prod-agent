# Runtime mode
PROD_AGENT_PROVIDER=demo
PROD_AGENT_MODEL=demo-rule-based
PROD_AGENT_CHECKPOINT_DB=/data/agent_checkpoints.db
PROD_AGENT_BUSINESS_DB=/data/demo_business.db

# Optional API protection. Leave empty for local-only demo.
PROD_AGENT_API_TOKEN=
PROD_AGENT_APPROVAL_TOKEN=

# Provider credentials when using real models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent budget and reliability.
PROD_AGENT_BUDGET_MAX_ITERATIONS=20
PROD_AGENT_BUDGET_MAX_TOTAL_TOKENS=500000
PROD_AGENT_BUDGET_MAX_COST_USD=5
PROD_AGENT_BUDGET_MAX_WALL_TIME_S=0
PROD_AGENT_RETRY_MAX_ATTEMPTS=5
PROD_AGENT_RETRY_TIMEOUT_S=120
PROD_AGENT_RATE_MAX_CALLS_PER_MINUTE=0
PROD_AGENT_RATE_MAX_CONCURRENT_CALLS=0

# Worker retention. 0 disables purging.
PROD_AGENT_PURGE_DAYS=0
PROD_AGENT_WORKER_POLL_INTERVAL_S=5
